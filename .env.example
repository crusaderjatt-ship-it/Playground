# Required for production persistence (Supabase Postgres recommended)
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require

# App/runtime settings
APP_NAME=AI Trend Radar
OPENAI_MODEL=gpt-4.1-mini
SCHEDULER_CRON=0 7 * * *

# Optional source/API integrations
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
NEWS_API_KEY=
